# ==========================================================================
#  Korean Beauty — настройки сервера
#
#  Для разработки на своём компьютере ничего задавать не нужно.
#
#  Render + Turso: эти переменные уже описаны в render.yaml, а три секретных
#  Render спросит при создании сайта. Файл .env там не нужен.
#
#  VPS: скопируйте этот файл в .env и заполните:  cp .env.example .env
#  Файл .env НЕ попадает в git — в нём пароли и токены.
# ==========================================================================

# Режим. production включает HSTS, журнал запросов и скрывает детали ошибок.
NODE_ENV=production

# Порт, на котором слушает приложение. nginx будет проксировать на него.
# Render задаёт порт сам.
PORT=3000

# Адрес интерфейса. 127.0.0.1 — принимать соединения только с этой машины
# (nginx рядом). 0.0.0.0 — со всех адресов (Render, Docker).
HOST=127.0.0.1

# Публичный адрес магазина — без слэша в конце. Нужен для карты сайта
# и превью ссылок в Telegram.
KB_PUBLIC_URL=https://koreanbeauty.uz

# --------------------------------------------------------------------------
#  База данных
# --------------------------------------------------------------------------

# Не задано — база в файле KB_DATA_DIR/shop.db (VPS, разработка).
# Turso — адрес и токен из панели turso.tech. Обязательно на Render:
# его диск стирается при перезапуске, и без внешней базы магазин не запустится.
# KB_DB_URL=libsql://korean-beauty-ЛОГИН.aws-eu-west-1.turso.io
# KB_DB_TOKEN=

# Папка с базой (когда она файлом) и резервными копиями.
KB_DATA_DIR=/var/lib/korean-beauty

# --------------------------------------------------------------------------
#  Безопасность
# --------------------------------------------------------------------------

# Кому доверять заголовки X-Forwarded-For и X-Forwarded-Proto.
# От этого зависят защита от подбора пароля и лимит заказов. Не ставьте true.
#   loopback    — nginx или Caddy на этой же машине (VPS)
#   cloudflare  — Render: перед сайтом Cloudflare и балансировщик
#   uniquelocal — прокси во внутренней сети (Docker)
#   1           — ровно один прокси перед приложением (Railway, Fly)
KB_TRUST_PROXY=loopback

# Ключ подписи входа в админку — длинная случайная строка.
# Не задан: на VPS создаётся в data/.session-secret, с Turso — хранится в базе.
# На Render его создаёт сам render.yaml.
# KB_SECRET=

# Логин и пароль администратора при САМОМ ПЕРВОМ запуске (когда база пуста).
# Если пароль не указан — сгенерируется случайный и напечатается в журнале.
# После первого запуска эти строки ни на что не влияют; менять: npm run password
# KB_ADMIN_USER=admin
# KB_ADMIN_PASS=

# --------------------------------------------------------------------------
#  Резервные копии (npm run backup)
# --------------------------------------------------------------------------

# Куда складывать и сколько хранить. Лучше на другой диск.
KB_BACKUP_DIR=/var/backups/korean-beauty
KB_BACKUP_KEEP=14
